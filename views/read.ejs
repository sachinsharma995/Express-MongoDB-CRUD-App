<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body>

<div class="w-full bg-zinc-900 p-10 text-white box-border min-h-screen">
    <div class="nav mb-6">
        <a class="text-blue-500 cursor-pointer" href="/">Back To Home</a>
    </div>
    <h1 class="text-3xl tracking-tighter mb-5">All Users</h1>
    <!-- USERS GRID -->
    <div class="users grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
        <!-- CARD -->
        <!-- <div class="p-4 bg-zinc-800 rounded-lg">
            <div class="w-full h-52 rounded-lg bg-zinc-700"></div>
            <h3 class="text-xl mt-2 tracking-tighter">Sachin Sharma</h3>
            <h5 class="text-zinc-500">sachin@gmail.com</h5>
            <div class="flex gap-3 mt-3">
                <a class="text-zinc-200" href="">Edit User</a>
                <a class="text-red-500" href="">Delete User</a>
            </div>
        </div> -->

        <% if(users.length > 0){ %>
            <% users.forEach(function(user) { %>
                <div class="p-4 bg-zinc-800 rounded-lg">
                <div class="w-full h-52 rounded-lg bg-zinc-700 overflow-hidden">
                    <img class="w-full h-full object-cover" src="<%= user.image %>" alt="image">
                </div>
                <h3 class="text-xl mt-2 tracking-tighter"><%= user.name %></h3>
                <h5 class="text-zinc-500"><%= user.email %></h5>
                <div class="flex gap-3 mt-3">
                    <a class="text-zinc-200" href="/edit/<%= user._id %>">Edit User</a>
                    <a class="text-red-500" href="/delete/<%= user._id %>">Delete User</a>
                </div>
            </div>
           <% }) %>
       <% } else{ %>
           <h1 class=" text-zinc-500">No Users Yet</h1>
      <% } %>
       


    </div>
</div>

</body>
</html>